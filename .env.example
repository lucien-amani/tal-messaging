# ---- Application ----
APP_NAME="TAL Messaging"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
# Sous-dossier d'installation (déduit automatiquement ; ex. XAMPP : /tal-messaging/public). "/" = racine.
# APP_BASE_PATH=
# Clé de chiffrement (>= 32 caractères). Générer : php scripts/init-env.php
APP_KEY=
APP_TIMEZONE=Africa/Lubumbashi

# ---- Base de données MySQL 8 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tal_messaging
DB_USER=tal
DB_PASSWORD=
# Docker uniquement
DB_ROOT_PASSWORD=

# ---- Sessions ----
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# ---- 2FA ----
# Tolérance TOTP en pas de 30 s (2 = ±60 s). Augmenter (max 4) si l'horloge du serveur dérive.
TOTP_WINDOW=2
# false = le super admin (compte interne) peut se connecter sans 2FA le temps de la dépanner ;
# remettre à true ensuite. Réinitialisation d'un compte : php scripts/reset-2fa.php email
ENFORCE_INTERNAL_2FA=true

# ---- Proxy de confiance (IP séparées par des virgules) ----
TRUSTED_PROXIES=

# ---- Seed (laisser vide = mot de passe aléatoire affiché une seule fois) ----
SEED_CEO_EMAIL=ceo@talmessaging.local
SEED_CEO_PASSWORD=
SEED_DEMO_PASSWORD=

# ---- Redis (réservé aux modules Queues/Workers, non utilisé au module 1) ----
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Fournisseurs Télécom (Module Messaging - Phase 1) ----
# Driver par défaut : mock (aucun appel réseau ni SMS réel). Mettre 'http' uniquement avec identifiants réels.
DEFAULT_MESSAGING_PROVIDER=africas_talking
AFRICASTALKING_DRIVER=mock
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_ENVIRONMENT=sandbox
AFRICASTALKING_TIMEOUT=8
